# Copie para .env e preencha. O .env nao vai para o Git.
# O docker-compose le este arquivo automaticamente (env_file).

# Token gratuito: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# Opcionais -- ja tem default no config.py (local) e no Dockerfile (container).
# COMPETITION_CODE=BSA
# FOCUS_TEAM=Coritiba Foot Ball Club
# DUCKDB_PATH=./data/warehouse/brasileirao.duckdb
# MLFLOW_TRACKING_URI=sqlite:///./mlruns/mlflow.db

# Opcional -- dbt/ingestao no Databricks SQL Warehouse
# DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
# DATABRICKS_TOKEN=
# DATABRICKS_CATALOG=workspace
# DATABRICKS_SCHEMA=brasileirao
# DATABRICKS_RAW_SCHEMA=brasileirao_raw
